{
	servers {
		timeouts {
			# HACK: the 1m default cuts idle NetBird gRPC streams.
			# Scope to those routes once caddyserver/caddy#8121 is released.
			read_body_idle -1s
		}
	}
}

(vpn-only) {
	@public not remote_ip 100.64.0.0/10 fd25:2656:b652:7123::/64
	respond @public 403
}

